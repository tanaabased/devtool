{
  "name": "@tanaab/devtool",
  "version": "0.0.0-unreleased",
  "description": "Tanaab-based development environments",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanaabased/devtool.git"
  },
  "type": "commonjs",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20.17.0"
  },
  "main": "./lib/devtool.js",
  "exports": "./lib/devtool.js",
  "bin": {
    "devtool": "./bin/devtool.js"
  },
  "scripts": {
    "devtool": "node ./bin/devtool.js",
    "test": "npm run test:unit && npm run test:cli",
    "test:unit": "mocha 'test/*.spec.js'",
    "test:cli": "leia examples/source/README.md --shell bash --retry 0 --timeout 10",
    "test:integration": "leia examples/l337/README.md examples/lando/README.md examples/consumer/README.md --shell bash --retry 0 --timeout 300",
    "leia": "leia"
  },
  "dependencies": {
    "ansis": "^4.0.0",
    "debug": "^4.3.4",
    "dockerfile-generator": "^5.0.0",
    "dockerode": "^2.4.2",
    "fs-extra": "^11.1.1",
    "glob": "^7.1.3",
    "js-yaml": "^4.1.0",
    "jsonfile": "^2.4.0",
    "listr2": "^6.6.1",
    "lodash": "^4.17.21",
    "mkcert": "3.2.0",
    "nanoid": "^3",
    "slugify": "^1.6.5",
    "string-argv": "0.1.1",
    "valid-path": "^2.1.0"
  },
  "devDependencies": {
    "@lando/leia": "1.0.0-beta.4",
    "mocha": "^11.7.0"
  }
}
