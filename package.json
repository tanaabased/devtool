{
  "name": "@tanaab/devtool",
  "version": "0.0.0-unreleased",
  "description": "Tanaab-based development environments",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanaabased/devtool.git"
  },
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "main": "./lib/devtool.js",
  "exports": "./lib/devtool.js",
  "bin": {
    "devtool": "./bin/devtool.js"
  },
  "scripts": {
    "devtool": "bun ./bin/devtool.js",
    "test": "bun run test:unit && bun run test:cli",
    "test:unit": "bun ./node_modules/mocha/bin/mocha.js 'test/*.spec.js'",
    "test:cli": "bun run leia examples/source/README.md --shell bash --retry 0 --timeout 10",
    "leia": "bun ./node_modules/.bin/leia"
  },
  "dependencies": {
    "ansis": "^4.0.0",
    "debug": "^4.3.4",
    "dockerfile-generator": "^5.0.0",
    "dockerode": "^2.4.2",
    "fs-extra": "^11.1.1",
    "glob": "^7.1.3",
    "js-yaml": "^4.1.0",
    "jsonfile": "^2.4.0",
    "listr2": "^6.6.1",
    "lodash": "^4.17.21",
    "nanoid": "^3",
    "shelljs": "^0.8.4",
    "slugify": "^1.6.5",
    "string-argv": "0.1.1",
    "valid-path": "^2.1.0",
    "winston": "2.4.5"
  },
  "devDependencies": {
    "@lando/leia": "^2.0.0",
    "mocha": "^11.7.0"
  }
}
